  "components": {
    "schemas": {
      "Briefing": {
        "properties": {
          "campaign_name": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Campaign Name"
          },
          "product_id": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Product Id"
          },
          "objective": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Objective"
          },
          "target_audience": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Target Audience"
          },
          "channels": {
            "items": {
              "$ref": "#/components/schemas/Channel"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Channels"
          },
          "additional_instructions": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ],
            "title": "Additional Instructions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "campaign_name",
          "product_id",
          "objective",
          "target_audience",
          "channels"
        ],
        "title": "Briefing"
      },
      "Campaign": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "briefing": {
            "$ref": "#/components/schemas/Briefing"
          },
          "pieces": {
            "items": {
              "$ref": "#/components/schemas/Piece"
            },
            "type": "array",
            "title": "Pieces"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "briefing",
          "pieces"
        ],
        "title": "Campaign"
      },
      "CampaignPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Campaign"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "CampaignPage"
      },
      "Channel": {
        "type": "string",
        "enum": [
          "feed",
          "story",
          "banner"
        ],
        "title": "Channel"
      },
      "Decision": {
        "type": "string",
        "enum": [
          "approved",
          "rejected"
        ],
        "title": "Decision"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Piece": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "campaign_id": {
            "type": "string",
            "title": "Campaign Id"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "subtitle": {
            "type": "string",
            "title": "Subtitle"
          },
          "cta": {
            "type": "string",
            "title": "Cta"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)",
            "title": "Price"
          },
          "authorized_offer": {
            "type": "string",
            "title": "Authorized Offer"
          },
          "state": {
            "$ref": "#/components/schemas/PieceState"
          },
          "validations": {
            "items": {
              "$ref": "#/components/schemas/ValidationRun"
            },
            "type": "array",
            "title": "Validations"
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/ReviewRecord"
            },
            "type": "array",
            "title": "Reviews"
          }
        },
        "type": "object",
        "required": [
          "id",
          "campaign_id",
          "channel",
          "title",
          "subtitle",
          "cta",
          "disclaimer",
          "product_id",
          "product_name",
          "price",
          "authorized_offer",
          "state",
          "validations",
          "reviews"
        ],
        "title": "Piece"
      },
      "PieceState": {
        "type": "string",
        "enum": [
          "draft",
          "validated",
          "approved",
          "rejected"
        ],
        "title": "PieceState"
      },
      "Product": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          },
          "category": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Category"
          },
          "price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,8}|(?=[\\d.]{1,11}0*$)\\d{0,8}\\.\\d{0,2}0*$)",
            "title": "Price"
          },
          "authorized_offer": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Authorized Offer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "category",
          "price",
          "authorized_offer"
        ],
        "title": "Product"
      },
      "ReviewDecision": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "reviewer_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reviewer Id"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "reviewer_id"
        ],
        "title": "ReviewDecision"
      },
      "ReviewRecord": {
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/Decision"
          },
          "reviewer_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Reviewer Id"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "reviewer_id",
          "id",
          "created_at",
          "fingerprint"
        ],
        "title": "ReviewRecord"
      },
      "Severity": {
        "type": "string",
        "enum": [
          "info",
          "warning",
          "critical"
        ],
        "title": "Severity"
      },
      "ValidationResult": {
        "properties": {
          "rule_code": {
            "type": "string",
            "title": "Rule Code"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "passed": {
            "type": "boolean",
            "title": "Passed"
          }
        },
        "type": "object",
        "required": [
          "rule_code",
          "severity",
          "message",
          "field",
          "passed"
        ],
        "title": "ValidationResult"
      },
      "ValidationRun": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "fingerprint": {
            "type": "string",
            "title": "Fingerprint"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ValidationResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created_at",
          "fingerprint",
          "success",
          "results"
        ],
        "title": "ValidationRun"
      }
