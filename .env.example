# Copie para .env e configure somente as chaves dos provedores que usar no Docker Compose.
GENERATION_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GENERATION_TIMEOUT_SECONDS=20
VISUAL_MAX_ATTEMPTS=2
IMAGE_GENERATION_PROVIDER=disabled
# IMAGE_GENERATION_PROVIDER=openai usa gpt-image-1-mini e OPENAI_API_KEY.
# IMAGE_GENERATION_PROVIDER=mock usa IMAGE_MOCK_PATH (arquivo PNG local ao backend).
IMAGE_MOCK_PATH=
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_SIZE=2K
IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_ATTEMPTS=2
