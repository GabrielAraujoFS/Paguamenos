# Set these environment variables in your shell. No dotenv dependency is used.
DATABASE_URL=sqlite:///./creative_factory.db
CORS_ORIGINS=http://localhost:5173
GENERATION_PROVIDER=mock
# Only required for gemini; supply the real key in the backend shell, never commit it.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GENERATION_TIMEOUT_SECONDS=20
VISUAL_MAX_ATTEMPTS=2
# Persistent local assets; Docker overrides this to /data/creative-assets.
IMAGE_STORAGE_ROOT=./creative-assets
# Image generation is disabled until explicitly enabled; paid API usage may apply.
IMAGE_GENERATION_PROVIDER=disabled
# openai usa gpt-image-1-mini; mock usa IMAGE_MOCK_PATH apontando para um PNG local.
IMAGE_MOCK_PATH=
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_SIZE=2K
IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_ATTEMPTS=2
